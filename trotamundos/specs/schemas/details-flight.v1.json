{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trotamundos.example/specs/schemas/details-flight.v1.json",
  "title": "Detalles de una reserva de vuelo (flight.v1)",
  "description": "Bloque details de una reserva de tipo flight (ADR-0066). Los campos comunes (fechas, zona horaria, lugares de salida y llegada, estado, proveedor, referencia) no se repiten acá. Sin códigos de reserva ni datos personales.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "flightNumber"
  ],
  "properties": {
    "schema": {
      "const": "flight.v1"
    },
    "flightNumber": {
      "type": "string",
      "pattern": "^[A-Z0-9]{2}[0-9]{1,4}[A-Z]?$"
    },
    "terminal": {
      "type": "string"
    },
    "gate": {
      "type": "string"
    },
    "seat": {
      "type": "string"
    },
    "cabin": {
      "type": "string",
      "enum": [
        "economy",
        "premium_economy",
        "business",
        "first"
      ]
    }
  }
}
